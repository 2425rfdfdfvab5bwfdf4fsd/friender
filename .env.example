# PACCA v8.0 — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# ── LLM Providers ────────────────────────────────────────────────────────────
# Set at least one. Anthropic (Claude) is the default.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Security ──────────────────────────────────────────────────────────────────
# When set, all API endpoints and the WebSocket require this Bearer token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PACCA_ADMIN_TOKEN=

# Comma-separated list of allowed WebSocket Origins (host names, not full URLs).
# Leave blank to allow all origins (default for local dev).
# PACCA_ALLOWED_ORIGINS=localhost,127.0.0.1,yourdomain.com

# ── WhatsApp Integration (optional) ──────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_RECIPIENT=whatsapp:+1...

# ── Google Calendar Integration (optional) ───────────────────────────────────
# Place your service-account JSON at ~/.pacca/google_service_account.json
# GOOGLE_CALENDAR_ID=primary

# ── Runtime Tuning ────────────────────────────────────────────────────────────
# How many seconds before a tool call is killed (default: 60)
# PACCA_TOOL_TIMEOUT=60

# Override config file location (default: ~/.pacca/config.json)
# PACCA_CONFIG_PATH=
