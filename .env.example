# Arix v9.3 — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values you need.
#   Windows:   copy .env.example .env   (or run setup.bat)
#   Mac/Linux: cp .env.example .env     (or run bash setup.sh)
#
# Never commit .env to version control — it contains your private keys.
# ─────────────────────────────────────────────────────────────────────────────


# ── AI Providers — set at least one ──────────────────────────────────────────
# Arix will use the first provider whose key is present.
# If none are set AND Ollama is running locally, Arix auto-uses Ollama.
# If nothing is configured, Arix falls back to heuristic demo mode.

ANTHROPIC_API_KEY=sk-ant-...          # Claude (default, best results)
# OPENAI_API_KEY=sk-...              # GPT-4 + enables vector memory search
# GEMINI_API_KEY=...                 # Google Gemini (free tier available)
# GROQ_API_KEY=...                   # Groq (very fast, free tier)
# OPENROUTER_API_KEY=...             # OpenRouter (access many models via one key)


# ── Security (optional — recommended if others can reach your PC) ─────────────
# When set, all API endpoints and the WebSocket require this Bearer token.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ARIX_ADMIN_TOKEN=

# Comma-separated allowed WebSocket origins (blank = allow all — fine for local use)
# ARIX_ALLOWED_ORIGINS=localhost,127.0.0.1


# ── Runtime Tuning ────────────────────────────────────────────────────────────
# Tool call timeout in seconds (default: 60)
# PACCA_TOOL_TIMEOUT=60


# ── Gmail Integration ─────────────────────────────────────────────────────────
# Tools: list, read, search, send, delete emails
# Setup: console.cloud.google.com → APIs & Services → Enable Gmail API
#        Create OAuth 2.0 Client ID (Desktop App) → run OAuth flow for refresh token
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token


# ── Google Drive Integration ──────────────────────────────────────────────────
# Tools: list, read, search, upload files
# Same Google Cloud project as Gmail — just enable Drive API too
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token


# ── Google Calendar Integration ───────────────────────────────────────────────
# Tools: list events, create event, delete event
# Same Google Cloud project — enable Calendar API
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token


# ── Notion Integration ────────────────────────────────────────────────────────
# Tools: search, read page, create page, append to page
# Setup: notion.so/my-integrations → New Integration → copy Internal Integration Token
# NOTION_API_KEY=secret_your-notion-token-here


# ── Slack Integration ─────────────────────────────────────────────────────────
# Tools: list channels, send message, get messages, search
# Setup: api.slack.com/apps → Create App → OAuth & Permissions → add bot scopes:
#        chat:write, channels:read, channels:history, search:read → Install → copy Bot Token
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token


# ── Trello Integration ────────────────────────────────────────────────────────
# Tools: list boards, list cards, create card, get lists
# Setup: trello.com/app-key → copy API Key, generate Token on same page
# TRELLO_API_KEY=your-trello-api-key
# TRELLO_API_TOKEN=your-trello-token


# ── Spotify Integration ───────────────────────────────────────────────────────
# Tools: search music, get current track, play/pause
# Setup: developer.spotify.com/dashboard → Create App → copy Client ID + Secret
# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_CLIENT_SECRET=your-client-secret


# ── YouTube Integration ───────────────────────────────────────────────────────
# Tools: search videos, get video info, search channels
# Setup: console.cloud.google.com → APIs & Services → Enable YouTube Data API v3
#        → Create API Key
# YOUTUBE_API_KEY=your-youtube-api-key


# ── WhatsApp Integration ──────────────────────────────────────────────────────
# Tools: send WhatsApp messages
# Setup: twilio.com → enable WhatsApp Sandbox → copy Account SID + Auth Token
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_RECIPIENT=whatsapp:+1your-number
